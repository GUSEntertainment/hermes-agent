+            **budget_report,
+            'failure_history_preserved': True, 'worker_started': False,
+            'status_preserved': task['status'],
+            'expected_state': control.describe(conn, task_id)['expected_state'],
+            'next_action': inspect(conn, task_id)['next_action']}
