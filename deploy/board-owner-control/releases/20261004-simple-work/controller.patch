+                'dependencies_satisfied': kb._parents_satisfied(conn, task_id),
+                'preserved_stop': stop, 'action_restrictions_preserved': True,
+                'next_action': 'Normal worker admission and dispatch; do available authorized work and preserve outstanding external actions and final acceptance.'}
