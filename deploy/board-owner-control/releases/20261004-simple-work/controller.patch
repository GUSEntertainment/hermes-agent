+    assert board.execute('SELECT COUNT(*) FROM task_events WHERE task_id=? AND kind IN (%s)' % ','.join('?' * len(RELEASE_EVENTS)), (tid, *RELEASE_EVENTS)).fetchone()[0] == original_releases
+    assert start.allows_claim(board, current)
