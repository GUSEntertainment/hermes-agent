+import argparse
+from dataclasses import asdict
+
+import pytest
+
+from gateway import gus_admin_cli as admin
+from hermes_cli import kanban_db as kb
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setenv('HERMES_KANBAN_DB', str(tmp_path / 'board.db'))
+    for key in ('HERMES_PROFILE','HERMES_KANBAN_TASK','HERMES_SESSION_SOURCE','HERMES_KANBAN_BOARD'):
+        monkeypatch.delenv(key, raising=False)
+    kb.init_db()
+    with kb.connect_closing() as c:
+        yield c
+
+
+def evidence(c, title='Local continuity repair'):
