+"""Bounded review recovery: disposable DB, no workers, services or model calls."""
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import owner_cell as oc
+
+from hermes_cli import owner_board_recovery as recovery
+
+
+@pytest.fixture
+def held_review(tmp_path, monkeypatch):
+    for name in ("HERMES_KANBAN_DB", "HERMES_KANBAN_BOARD", "HERMES_KANBAN_HOME",
+                 "HERMES_KANBAN_WORKSPACES_ROOT", "HERMES_KANBAN_TASK",
+                 "HERMES_KANBAN_RUN_ID", "HERMES_SESSION_SOURCE"):
+        monkeypatch.delenv(name, raising=False)
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setattr(oc, "_installed_profile", lambda name: name)
+    conn = kb.connect(home / "kanban.db")
+    contract = {
+        "goal_id": "isolated-owner-review", "objective": "fixture artifact",
+        "owner_profile": "steven", "owner_role_alias": "legal",
+        "runtime_profile": "legal-drafter", "required_reviewer_profile": "steven",
+        "security_realm": "private", "router_mode": "reviewed", "risk_class": "material",
+        "capability_bundle": "legal", "worker_budget": {"producers": 1, "reviewers": 1, "extras": 0, "max_rework_rounds": 2},
+        "targets": [], "acceptance_test": {"expected": "pass"},
+        "rollback": {"procedure_ref": "fixture://rollback"},
+        "callback": {"source_surface": "test", "return_surface": "test", "report_policy": "milestones_only"},
+        "approval_gates": ["external_send"],
+        "owner_acceptance": {"mode": "accountable_owner"},
+        "delegation_roles": {"maker": "legal-drafter", "reviewer": "steven"},
+    }
+    tid = kb.create_task(conn, title="owner reviewer fixture", assignee="legal-drafter", owner_cell_contract=contract)
+    artifact = tmp_path / "artifact.txt"
+    artifact.write_text("Bound document with unresolved finding.")
+    digest = hashlib.sha256(artifact.read_bytes()).hexdigest()
+    assert kb.request_review(conn, tid, summary="ready for review", reviewer="steven",
+                             metadata={"owner_cell_artifact": {"ref": str(artifact), "digest": digest}})
+    # Seed the exact obsolete runtime projection: one prior correction, no
+    # active claim, held review, missing optional senior and existing findings.
+    conn.execute("UPDATE owner_cell_goals SET review_loop_count=1 WHERE task_id=?", (tid,))
+    oc.record_verdict(conn, tid, reviewer_profile="steven", state_version=1,
+                      artifact_ref=str(artifact), artifact_digest=digest,
+                      verdict="REQUEST_CHANGES", defects=["existing defect must remain"])
+    conn.execute("UPDATE tasks SET status='triage',block_kind='needs_input',block_recurrences=2,consecutive_failures=1 WHERE id=?", (tid,))
+    kb._append_event(conn, tid, "block_loop_detected", {"reason": "repair loop limit requires a senior owner", "source_status": "review"})
+    conn.commit()
+    cid = kb.add_comment(conn, tid, "steven", "Existing reviewer findings require correction.")
+    task = conn.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone()
+    goal = oc.goal_projection(conn, tid)
+    stop = conn.execute("SELECT MAX(id) FROM task_events WHERE task_id=? AND kind='block_loop_detected'", (tid,)).fetchone()[0]
+    args = dict(expected_task_sha256=kb.triage_snapshot_sha(task),
+                expected_goal_sha256=recovery.goal_snapshot_sha(goal),
+                expected_stop_event_id=stop, expected_latest_comment_id=cid,
+                evidence_comment_ids=[cid], actor="default", reason="Existing owner restores held review after the missing-senior routing fix.")
+    yield conn, tid, args, artifact
+    conn.close()
+
+
+def state(conn, tid):
+    return (
+        dict(conn.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone()),
+        dict(oc.goal_projection(conn, tid)),
+        [dict(r) for r in conn.execute("SELECT * FROM review_verdicts WHERE task_id=?", (tid,))],
+        conn.execute("SELECT COUNT(*) FROM task_events WHERE task_id=?", (tid,)).fetchone()[0],
+    )
+
+
+def test_dry_run_is_exactly_read_only(held_review):
+    conn, tid, args, _ = held_review
+    before = state(conn, tid)
+    result = recovery.recover_review(conn, tid, **args)
+    assert result["dry_run"] and result["proposed_status"] == "review"
+    assert state(conn, tid) == before
+
+
+def test_apply_preserves_findings_custody_limits_and_restores_only_review(held_review):
+    conn, tid, args, _ = held_review
+    before_task, before_goal, before_verdicts, _ = state(conn, tid)
+    result = recovery.recover_review(conn, tid, **args, dry_run=False)
+    after_task, after_goal, after_verdicts, _ = state(conn, tid)
+    assert result["status"] == "review" and result["dispatch_performed"] is False
+    assert after_task == {**before_task, "status": "review"}
+    assert after_verdicts == before_verdicts
+    for key in ("phase", "owner_profile", "runtime_profile", "security_realm", "review_loop_count",
+                "review_state_version", "current_state_version", "review_artifact_ref", "review_artifact_digest", "approval_gates_json", "worker_budget_json"):
+        assert after_goal[key] == before_goal[key]
+    assert after_goal["senior_owner_profile"] == "steven"
+    assert json.loads(after_goal["contract_json"])["runtime_profile"] == "legal-drafter"
+    assert kb.request_changes(conn, tid, reason="not an authenticated active reviewer")[0] is False
+    with pytest.raises(oc.OwnerCellGuardError, match="PASS"):
+        oc.assert_completion_allowed(conn, tid)
+
+
+@pytest.mark.parametrize("changed", ["comment", "goal", "artifact", "claim", "dependency", "foreign_evidence", "worker"])
+def test_recovery_rejects_stale_or_unowned_evidence(held_review, monkeypatch, changed):
+    conn, tid, args, artifact = held_review
+    if changed == "comment":
+        kb.add_comment(conn, tid, "default", "New instruction.")
+    elif changed == "goal":
+        conn.execute("UPDATE owner_cell_goals SET review_loop_count=2 WHERE task_id=?", (tid,)); conn.commit()
+    elif changed == "artifact":
+        artifact.write_text("changed")
+    elif changed == "claim":
+        conn.execute("UPDATE tasks SET claim_lock='active' WHERE id=?", (tid,)); conn.commit()
+    elif changed == "dependency":
+        parent = kb.create_task(conn, title="unfinished prerequisite", assignee="steven")
+        kb.link_tasks(conn, parent, tid)
+    elif changed == "foreign_evidence":
+        other = kb.create_task(conn, title="different private card", assignee="steven")
+        args["evidence_comment_ids"] = [kb.add_comment(conn, other, "steven", "Unrelated review evidence.")]
+    else:
+        monkeypatch.setenv("HERMES_KANBAN_TASK", "different-worker")
+    before = state(conn, tid)
+    with pytest.raises((ValueError, PermissionError, oc.OwnerCellGuardError)):
+        recovery.recover_review(conn, tid, **args, dry_run=False)
+    assert state(conn, tid) == before
+
+
+def test_existing_second_correction_keeps_maker_and_stops_at_budget(held_review):
+    conn, tid, args, _ = held_review
+    recovery.recover_review(conn, tid, **args, dry_run=False)
+    result = oc.request_changes_same_card(conn, tid)
+    assert result.runtime_profile == "legal-drafter"
+    assert result.owner_profile == "steven" and result.review_loop_count == 2
+    oc.update_state(conn, tid, expected_version=1, facts=["bounded correction"])
+    oc.begin_review(conn, tid, reviewer_profile="steven", artifact_ref="new", artifact_digest="new-digest")
+    oc.record_verdict(conn, tid, reviewer_profile="steven", state_version=2,
+                      artifact_ref="new", artifact_digest="new-digest", verdict="REQUEST_CHANGES", defects=["new defect"])
+    with pytest.raises(oc.OwnerCellGuardError, match="repair budget exhausted"):
+        oc.request_changes_same_card(conn, tid)
+    assert oc.goal_projection(conn, tid)["review_loop_count"] == 2
